                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1.3*"/>
                </Grid.RowDefinitions>
                <Label Content="Ankunft ca.:" Margin="0" VerticalContentAlignment="Center" Background="Brown" Padding="5,0" FontWeight="Bold" FontSize="16" />
                <Label Content="Beste Ankunft:" Grid.Row="1" VerticalContentAlignment="Center" Padding="5,0" FontSize="16" />
                <Label Content="Beste Fahrzeit:" Grid.Row="2" Margin="0" VerticalContentAlignment="Center" FontSize="10" Background="DarkGray" Padding="5,0"/>
                <Label Content="00:00 Uhr" VerticalContentAlignment="Center" Grid.ColumnSpan="1" Grid.Column="1" HorizontalContentAlignment="Center" Background="Brown" Padding="0" FontWeight="Bold" FontSize="16"/>
