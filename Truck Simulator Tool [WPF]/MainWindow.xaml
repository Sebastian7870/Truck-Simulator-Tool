                <Label Content="00:00 - 00:00 Uhr" Grid.Row="2" Margin="0" VerticalContentAlignment="Center" Grid.Column="1" HorizontalContentAlignment="Center" FontSize="10" Background="DarkGray" Padding="0"/>
