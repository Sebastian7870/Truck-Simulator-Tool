            </Grid>
            <Canvas HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,15,0,0" Width="410" Height="268" Background="Gainsboro">
                <Label Content="Auftragsinformationen" Height="72" Width="410" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="DarkGray"/>
                <Canvas Canvas.Top="152" Height="116" Width="410" VerticalAlignment="Bottom" Background="DarkGray">
                    <Label Content="Leerfahrt" Height="25" Width="410" Padding="5,0,5,0.2" VerticalContentAlignment="Center"/>
                    <Label Content="0 t" Height="25" Width="410" Padding="5,0,5,0.2" VerticalContentAlignment="Center" Canvas.Top="25"/>
                    <Label Content="0 € (0 €/km)" Height="25" Width="410" Padding="5,0,5,0.2" VerticalContentAlignment="Center" Canvas.Top="50"/>
                    <ProgressBar Height="25" Foreground="Brown" Value="0" Background="White" Width="400" Canvas.Top="81" Canvas.Left="5"/>
                </Canvas>
                <Label x:Name="label_nextRestStop" Content="Pause in: 0 Min." Canvas.Top="72" Height="40" Width="205" VerticalContentAlignment="Center" Foreground="Brown"/>
