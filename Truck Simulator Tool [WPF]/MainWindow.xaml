                <MenuItem Header="Server starten" IsEnabled="False" />
                <MenuItem Header="IP Adresse" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="Schichtplaner" >
                <MenuItem Header="Schichtplan speichern" IsEnabled="False" />
                <MenuItem Header="Schichtplan laden" />
            </MenuItem>
            <MenuItem Header="Auftrag" >
                <MenuItem Header="Auftrag speichern" IsEnabled="False" />
                <MenuItem Header="Auftrag laden" />
            </MenuItem>
            <MenuItem Header="AntiKick" >
                <MenuItem Header="AntiKick" IsCheckable="True"/>
            </MenuItem>
            <MenuItem Header="Einstellungen" >
                <MenuItem Header="Einstellungen" />
            </MenuItem>
            <Label/>
        </Menu>
        <Grid DockPanel.Dock="Top" Margin="0" Height="70">
