                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Label Content="Startdatum:" VerticalContentAlignment="Center" Grid.ColumnSpan="2" Margin="0" Padding="0,0,5,0" FontSize="14" Grid.Column="1"/>
                    <Label Content="Fahrzeit (Std.):" Grid.Row="1" VerticalContentAlignment="Center" Grid.ColumnSpan="2" Padding="0,0,5,0" FontSize="14" Grid.Column="1" Margin="0"/>
                    <Label Content="Dauer (Tage):" Grid.Column="4" VerticalContentAlignment="Center" Padding="5,0" FontSize="14" Margin="0"/>
                    <Label Content="Pausezeit (Std.):" Grid.Row="1" Grid.Column="4" VerticalContentAlignment="Center" Padding="5,0" FontSize="14" Margin="0"/>
                    <xctk:DoubleUpDown Grid.Column="2" Grid.Row="1" DefaultValue="9" DisplayDefaultValueOnEmptyText="True" FontSize="14" Margin="0,2"/>
                    <xctk:DateTimePicker Grid.Column="2" Height="22" Format="Custom" FormatString="dddd, dd.MM.yyyy HH:mm" FontSize="14" Margin="0,2"/>
                    <xctk:IntegerUpDown Grid.Column="5" DefaultValue="7" FontSize="14" Margin="0,2" DisplayDefaultValueOnEmptyText="True"/>
                    <xctk:DoubleUpDown Grid.Column="5" DefaultValue="12" DisplayDefaultValueOnEmptyText="True" FontSize="14" Margin="0,2" Grid.Row="1"/>
