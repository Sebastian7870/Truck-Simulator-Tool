                <Label Content="Std." Canvas.Left="348" Canvas.Top="95" Width="32" Height="20" FontSize="10" Padding="3,0,0,0" VerticalContentAlignment="Center"/>
                <Label Content="Std." Canvas.Left="348" Canvas.Top="125" Width="32" Height="20" FontSize="10" Padding="3,0,0,0" VerticalContentAlignment="Center"/>
                <Label Content="Std." Canvas.Left="348" Canvas.Top="154" Width="32" Height="20" FontSize="10" Padding="3,0,0,0" VerticalContentAlignment="Center"/>
                <xctk:IntegerUpDown Canvas.Left="168" Canvas.Top="266" Width="180" Height="20" DefaultValue="65" FontSize="14" DisplayDefaultValueOnEmptyText="True"/>
                <Label Content="Ø Geschwindigkeit:" Canvas.Left="5" Canvas.Top="266" Width="160" Height="20" FontSize="14" Padding="0" VerticalContentAlignment="Center"/>
                <Label Content="km/h&#xa;mph" Canvas.Left="348" Canvas.Top="260" Width="32" Height="30" FontSize="10" Padding="3,0,0,0" VerticalContentAlignment="Center"/>
                <xctk:IntegerUpDown Canvas.Left="168" Canvas.Top="345" Width="180" Height="20" DisplayDefaultValueOnEmptyText="True" DefaultValue="0" FontSize="14"/>
                <Label Content="Fahrzeit:" Canvas.Left="5" Canvas.Top="345" Width="160" Height="20" FontSize="14" Padding="0" VerticalContentAlignment="Center"/>
                <Label Content="km&#xa;mi" Canvas.Left="348" Canvas.Top="340" Width="32" Height="30" FontSize="10" Padding="3,0,0,0" VerticalContentAlignment="Center"/>
                <Label Content="Zeitskalierung: 19" Canvas.Left="168" Canvas.Top="286" Width="180" Height="20" FontSize="12" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" BorderThickness="2" Margin="0,0,0,0" Height="400" Width="380" />
            </Canvas>
        </Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Height="235" DockPanel.Dock="Top" Margin="0,15,0,0">
            <Canvas Width="410" Margin="15,0,0,0" Background="Gainsboro">
                <Label Content="Fahrzeuginformationen" Height="72" Width="410" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="DarkGray"/>
                <Label Content="Rundumleuchte:" Canvas.Top="80" Height="35" Width="205" VerticalContentAlignment="Center" FontSize="18"/>
                <Label Content="Ø Geschwindigkeit:" Canvas.Top="115" Height="35" Width="205" VerticalContentAlignment="Center" FontSize="18" Background="#FFCFCFCF"/>
                <Label Content="Kraftstoffverbrauch:" Canvas.Top="150" Height="35" Width="205" VerticalContentAlignment="Center" FontSize="18"/>
                <ProgressBar Height="35" Foreground="LimeGreen" Value="0" Background="White" Width="400" Canvas.Top="190" Padding="0" Margin="5,0,0,0"/>
                <Label Content="ausgeschaltet" Canvas.Left="205" Canvas.Top="80" Height="35" Width="205" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="18"/>
