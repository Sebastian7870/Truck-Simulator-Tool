                <xctk:DoubleUpDown Canvas.Left="168" Canvas.Top="125" Width="180" Height="20" DisplayDefaultValueOnEmptyText="True" DefaultValue="0" FontSize="14"/>
                <xctk:DoubleUpDown Canvas.Left="168" Canvas.Top="154" Width="180" Height="20" DisplayDefaultValueOnEmptyText="True" DefaultValue="0" FontSize="14"/>
                <Label Content="Fahrzeit:" Canvas.Left="5" Canvas.Top="95" Width="160" Height="20" FontSize="14" Padding="0" VerticalContentAlignment="Center"/>
