                <Label x:Name="label_dateTimeNowDate" Content="Mittwoch&#xa;05.08.2020" Canvas.Left="220" Width="120" Foreground="Gainsboro" FontSize="24" VerticalContentAlignment="Center" Padding="0" Height="70" HorizontalAlignment="Right"/>
                <Label Content="Mo 0:00"  Height="25" Padding="0" Width="110" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontSize="20" FontWeight="Bold" Canvas.Left="205" Canvas.Top="-25"/>
