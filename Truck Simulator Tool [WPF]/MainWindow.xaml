            </Label>
            <Label  Margin="0" Foreground="Gainsboro" Background="Brown" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="30" Grid.Column="1" FontWeight="Bold" Padding="25,5">
                <Label.Content>
                    <AccessText TextWrapping="Wrap" Text="Keinen aktiven Auftrag" FontSize="24" TextAlignment="Center"/>
                </Label.Content>
            </Label>
            <Label Margin="0" Foreground="Gainsboro" Background="Brown" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="30" Grid.Column="2" FontWeight="Bold" Padding="25,5">
