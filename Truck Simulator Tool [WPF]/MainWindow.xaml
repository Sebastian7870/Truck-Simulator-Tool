<Window x:Class="Truck_Simulator_Tool__WPF_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Truck_Simulator_Tool__WPF_"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" 
        mc:Ignorable="d"
        Title="Truck Simulator Tool" Height="1080" Width="1920" Foreground="Black" MinWidth="1280" MinHeight="938" WindowStartupLocation="CenterScreen" FontFamily="Microsoft Sans Serif" FontSize="18" Background="LightGray">

    <DockPanel LastChildFill="true" Margin="0">
        <Menu Height="25" VerticalAlignment="Top" Background="White" DockPanel.Dock="Top" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
            <MenuItem x:Name="menuItem_serverStatus" Header="Server" Height="25" Background="Brown" Foreground="Gainsboro">
                <MenuItem x:Name="menuItem_serverInstall" Header="Server installieren" Foreground="Black" Click="menuItem_serverInstall_Click"/>
                <MenuItem x:Name="menuItem_serverUninstall" Header="Server deinstallieren" Foreground="Black" Click="menuItem_serverUninstall_Click"/>
                <MenuItem x:Name="menuItem_serverStart" Header="Server starten" IsEnabled="False" Foreground="Black" Click="menuItem_serverStart_Click" />
                <MenuItem x:Name="menuItem_serverIP" Header="IP Adresse" IsEnabled="False" Foreground="Black" Click="menuItem_serverIP_Click" />
            </MenuItem>
            <MenuItem Header="Schichtplaner" >
                <MenuItem x:Name="menuItem_shiftScheduleSave" Header="Schichtplan speichern" IsEnabled="False" Click="menuItem_shiftScheduleSave_Click" />
                <MenuItem x:Name="menuItem_shiftScheduleLoad" Header="Schichtplan laden" Click="menuItem_shiftScheduleLoad_Click" />
            </MenuItem>
            <MenuItem Header="Auftrag" >
                <MenuItem x:Name="menuItem_contractSave" Header="Auftrag speichern" IsEnabled="False" />
                <MenuItem x:Name="menuItem_contractLoad" Header="Auftrag laden" />
            </MenuItem>
            <MenuItem Header="AntiKick" >
                <MenuItem x:Name="menuItem_antiKick" Header="AntiKick" IsCheckable="True" Click="menuItem_antiKick_Click" />
            </MenuItem>
            <MenuItem Header="Einstellungen" >
                <MenuItem x:Name="menuItem_settings" Header="Einstellungen" Click="menuItem_settings_Click" />
            </MenuItem>
        </Menu>
        <Grid DockPanel.Dock="Top" Margin="0" Height="70">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            <Label  x:Name="label_connectionStatus" Margin="0" Foreground="Gainsboro" Background="Brown"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="30" FontWeight="Bold"  Padding="25,5">
                <Label.Content>
                    <AccessText x:Name="accessText_connectionStatus" TextWrapping="Wrap" Text="Keine Verbindung zum Spiel" FontSize="24" TextAlignment="Center"/>
                </Label.Content>
            </Label>
            <Label x:Name="label_contractStatus"  Margin="0" Foreground="Gainsboro" Background="Brown" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="30" Grid.Column="1" FontWeight="Bold" Padding="25,5">
                <Label.Content>
                    <AccessText x:Name="accessText_contractStatus" TextWrapping="Wrap" Text="Keinen aktiven Auftrag" FontSize="24" TextAlignment="Center"/>
                </Label.Content>
            </Label>
            <Label x:Name="label_shiftStatus" Margin="0" Foreground="Gainsboro" Background="Brown" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="30" Grid.Column="2" FontWeight="Bold" Padding="25,5">
                <Label.Content>
                    <AccessText x:Name="accessText_shiftStatus" TextWrapping="Wrap" Text="Keine Schicht geladen" FontSize="24" TextAlignment="Center"/>
                </Label.Content>
            </Label>
            <Canvas Grid.Column="3" Margin="0" Background="DimGray">
                <Label x:Name="label_dateTimeNowSeconds" Content="00" Canvas.Top="45" Padding="0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Height="12" Width="18" Foreground="Gainsboro" Canvas.Left="33" FontSize="12" RenderTransformOrigin="0.63,0.556"/>
                <Label x:Name="label_dateTimeNowTime" Content="00:00" Canvas.Left="56" Foreground="Gainsboro" Height="70" Width="159" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="0,0,10,0" FontSize="60" Margin="0"/>
                <Label x:Name="label_dateTimeNowDate" Content="Montag&#xA;01.01.0001" Canvas.Left="220" Width="120" Foreground="Gainsboro" FontSize="24" VerticalContentAlignment="Center" Padding="0" Height="70" HorizontalAlignment="Right"/>
                <Label x:Name="label_ingameTime" Content="Mo 0:00"  Height="25" Padding="0" Width="110" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontSize="20" FontWeight="Bold" Canvas.Left="205" Canvas.Top="-25"/>
            </Canvas>
        </Grid>
        <Grid Background="DarkGray" DockPanel.Dock="Bottom" Height="35" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="275*"/>
                <ColumnDefinition Width="160*"/>
                <ColumnDefinition Width="150*"/>
                <ColumnDefinition Width="275*"/>
                <ColumnDefinition Width="80*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" BorderThickness="2" Margin="-10,0,-10,-10" Grid.ColumnSpan="6" />
            <Label x:Name="label_shiftCount" Content="Schicht: ---" Margin="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11" Padding="3,0" Visibility="Hidden"/>
            <Label x:Name="label_nextShiftEvent" Content="Nächstes Schichtereignis: ---" Grid.Column="1" FontSize="11" Padding="3,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Visibility="Hidden"/>
            <Label x:Name="label_shiftTimeLeft" Content="Übrige Schichtlänge: ---" Grid.Column="2" Margin="0" Padding="3,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11" Visibility="Hidden"/>
            <Label x:Name="label_nextShiftPause" Content="Nächste Pause in: ---" Grid.Column="3" Margin="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="3,0" FontSize="11" Visibility="Hidden"/>
            <Label x:Name="label_currentShift" Content="Derzeitige Schicht: ---" Grid.Column="4" Margin="0" Padding="3,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11" Visibility="Hidden"/>
            <Label x:Name="label_timeScale" Content="Zeitskalierung: -" Grid.Column="5" Margin="0" Padding="3,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11"/>

        </Grid>
        <Grid DockPanel.Dock="Right"  Width="780" Margin="0,15,15,0">
            <Canvas Margin="0" Height="400" VerticalAlignment="Top" Width="380" HorizontalAlignment="Left" Background="Gainsboro">
                <Canvas x:Name="canvas_tfmSongPicture" Height="270" Canvas.Left="10" Canvas.Top="10" Width="360" OpacityMask="White" />
                <Label x:Name="label_tfmSongTitle" Content="" Canvas.Left="10" Canvas.Top="285" Width="360" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Top" HorizontalAlignment="Center" Padding="0" Height="30" FontSize="20"/>
                <Label x:Name="label_tfmSongAuthor"  Content="" Canvas.Left="10" Canvas.Top="315" Width="360" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Top" HorizontalAlignment="Center" Padding="0" Height="30" FontSize="20"/>
                <Label x:Name="label_tfmDJName" Content="" Canvas.Left="10" Canvas.Top="350" Width="360" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Top" HorizontalAlignment="Center" RenderTransformOrigin="0.486,1.367" FontSize="12" Height="26"/>
                <Label x:Name="label_tfmDuration"  Content="" Canvas.Left="10" Canvas.Top="376" Width="360" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Top" HorizontalAlignment="Center" RenderTransformOrigin="0.486,1.367" FontSize="12"/>
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" BorderThickness="2" Margin="0,0,0,0" Height="400" Width="380" />
            </Canvas>
            <Grid Background="Gainsboro" Margin="0,418,0,10">
                <Label Content="Schichtplaner" Height="72" VerticalAlignment="Top" FontSize="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="DarkGray"/>
                <Grid Margin="0,80,0,0" Height="58" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Label Content="Startdatum:" VerticalContentAlignment="Center" Grid.ColumnSpan="2" Margin="0" Padding="0,0,5,0" FontSize="14" Grid.Column="1"/>
                    <Label Content="Fahrzeit (Std.):" Grid.Row="1" VerticalContentAlignment="Center" Grid.ColumnSpan="2" Padding="0,0,5,0" FontSize="14" Grid.Column="1" Margin="0"/>
                    <Label Content="Dauer (Tage):" Grid.Column="4" VerticalContentAlignment="Center" Padding="5,0" FontSize="14" Margin="0"/>
                    <Label Content="Pausezeit (Std.):" Grid.Row="1" Grid.Column="4" VerticalContentAlignment="Center" Padding="5,0" FontSize="14" Margin="0"/>
                    <xctk:DoubleUpDown x:Name="doubleUpDown_driveTimeHours" Grid.Column="2" Grid.Row="1" DefaultValue="9" DisplayDefaultValueOnEmptyText="True" FontSize="14" Margin="0,2"/>
                    <xctk:DateTimePicker x:Name="dateTimePicker_shiftStart" Grid.Column="2" Height="22" Format="Custom" FormatString="dddd, dd.MM.yyyy HH:mm" FontSize="14" Margin="0,2"/>
                    <xctk:IntegerUpDown x:Name="integerUpDown_durationDays" Grid.Column="5" DefaultValue="7" FontSize="14" Margin="0,2" DisplayDefaultValueOnEmptyText="True"/>
                    <xctk:DoubleUpDown x:Name="doubleUpDown_pauseTimeHours" Grid.Column="5" DefaultValue="12" DisplayDefaultValueOnEmptyText="True" FontSize="14" Margin="0,2" Grid.Row="1"/>
                </Grid>
                <Button x:Name="button_shiftCreate" Content="Schichtplan erstellen" Margin="10,143,398,0" VerticalAlignment="Top" Height="50" Background="LightSteelBlue" Click="button_shiftCreate_Click"/>
                <Button x:Name="button_shiftLoadDelete" Content="Schichtplan laden" Margin="405,143,10,0" VerticalAlignment="Top" Height="50" Background="LightSteelBlue" Click="button_shiftScheduleLoadDelete_Click"/>
            </Grid>
            <ListBox x:Name="listView_shiftScheduleText" Margin="10,621,10,20" VerticalContentAlignment="Center" FontSize="14" />
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" BorderThickness="2" Margin="0,418,0,10" />
            <Canvas Background="Gainsboro" Margin="395,0,0,0" Height="400" VerticalAlignment="Top" Width="380" HorizontalAlignment="Right">
                <Label Content="Distanzrechner" Height="72" VerticalAlignment="Top" FontSize="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="DarkGray" Width="380"/>
                <xctk:DoubleUpDown x:Name="doubleUpDown_distanceCalculatorTime1" Canvas.Left="168" Canvas.Top="95" Width="180" Height="20" DisplayDefaultValueOnEmptyText="True" DefaultValue="0" FontSize="14" ValueChanged="doubleUpDown_distanceCalculatorTime1_ValueChanged" Increment="0.25" GotFocus="doubleUpDown_distanceCalculatorTime1_GotFocus" MaxLength="3" Minimum="0" CultureInfo="(Default)"/>
                <xctk:DoubleUpDown x:Name="doubleUpDown_distanceCalculatorTime2" Canvas.Left="168" Canvas.Top="125" Width="180" Height="20" DisplayDefaultValueOnEmptyText="True" DefaultValue="0" FontSize="14" Increment="0.25" ValueChanged="doubleUpDown_distanceCalculatorTime2_ValueChanged" GotFocus="doubleUpDown_distanceCalculatorTime2_GotFocus" MaxLength="3" Minimum="0" CultureInfo="(Default)" Visibility="Hidden"/>
                <xctk:DoubleUpDown x:Name="doubleUpDown_distanceCalculatorTime3" Canvas.Left="168" Canvas.Top="154" Width="180" Height="20" DisplayDefaultValueOnEmptyText="True" DefaultValue="0" FontSize="14" ValueChanged="doubleUpDown_distanceCalculatorTime3_ValueChanged" Increment="0.25" GotFocus="doubleUpDown_distanceCalculatorTime3_GotFocus" MaxLength="3" Minimum="0" CultureInfo="(Default)" Visibility="Hidden" />
                <Label x:Name="label_distanceCalculatorText1_1" Content="Fahrzeit:" Canvas.Left="5" Canvas.Top="95" Width="160" Height="20" FontSize="14" Padding="0" VerticalContentAlignment="Center"/>
                <Label x:Name="label_distanceCalculatorText1_2" Content="Fahrzeit (15):" Canvas.Left="5" Canvas.Top="125" Width="160" Height="20" FontSize="14" Padding="0" VerticalContentAlignment="Center" Visibility="Hidden"/>
                <Label x:Name="label_distanceCalculatorText1_3" Content="Fahrzeit (3):" Canvas.Left="5" Canvas.Top="154" Width="160" Height="20" FontSize="14" Padding="0" VerticalContentAlignment="Center" Visibility="Hidden"/>
                <RadioButton x:Name="radioButton_distanceCalculatorDefault" Content="einfach" Canvas.Left="200" Canvas.Top="185" FontSize="14" FlowDirection="RightToLeft" IsChecked="True" Click="radioButton_distanceCalculatorDefault_Click"/>
                <RadioButton x:Name="radioButton_distanceCalculatorExtended" Content="erweitert" Canvas.Left="275" Canvas.Top="185" FontSize="14" FlowDirection="RightToLeft" Click="radioButton_distanceCalculatorExtended_Click"/>
                <Label x:Name="label_distanceCalculatorText2_1" Content="Std." Canvas.Left="348" Canvas.Top="95" Width="32" Height="20" FontSize="10" Padding="3,0,0,0" VerticalContentAlignment="Center"/>
                <Label x:Name="label_distanceCalculatorText2_2" Content="Std." Canvas.Left="348" Canvas.Top="125" Width="32" Height="20" FontSize="10" Padding="3,0,0,0" VerticalContentAlignment="Center" Visibility="Hidden"/>
                <Label x:Name="label_distanceCalculatorText2_3" Content="Std." Canvas.Left="348" Canvas.Top="154" Width="32" Height="20" FontSize="10" Padding="3,0,0,0" VerticalContentAlignment="Center" Visibility="Hidden"/>
                <xctk:IntegerUpDown x:Name="integerUpDown_distanceCalculatorAverageSpeed" Canvas.Left="168" Canvas.Top="266" Width="180" Height="20" DefaultValue="65" FontSize="14" DisplayDefaultValueOnEmptyText="True" ValueChanged="integerUpDown_distanceCalculatorAverageSpeed_ValueChanged" MaxLength="3" Minimum="0" CultureInfo="(Default)"/>
                <Label Content="Ø Geschwindigkeit:" Canvas.Left="5" Canvas.Top="266" Width="160" Height="20" FontSize="14" Padding="0" VerticalContentAlignment="Center"/>
                <Label Content="km/h&#xa;mph" Canvas.Left="348" Canvas.Top="260" Width="32" Height="30" FontSize="10" Padding="3,0,0,0" VerticalContentAlignment="Center"/>
                <xctk:IntegerUpDown x:Name="integerUpDown_distanceCalculatorDistance" Canvas.Left="168" Canvas.Top="345" Width="180" Height="20" DisplayDefaultValueOnEmptyText="True" DefaultValue="0" FontSize="14" ValueChanged="integerUpDown_distanceCalculatorDistance_ValueChanged" Increment="100" GotFocus="integerUpDown_distanceCalculatorDistance_GotFocus" MaxLength="5" Minimum="0" CultureInfo="(Default)"/>
                <Label Content="Distanz (ingame):" Canvas.Left="5" Canvas.Top="345" Width="160" Height="20" FontSize="14" Padding="0" VerticalContentAlignment="Center"/>
                <Label Content="km&#xa;mi" Canvas.Left="348" Canvas.Top="340" Width="32" Height="30" FontSize="10" Padding="3,0,0,0" VerticalContentAlignment="Center"/>
                <Label x:Name="label_distanceCalculatorTimeScale" Content="Zeitskalierung: 19" Canvas.Left="168" Canvas.Top="286" Width="180" Height="20" FontSize="12" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" BorderThickness="2" Margin="0,0,0,0" Height="400" Width="380" />
            </Canvas>
        </Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Height="235" DockPanel.Dock="Top" Margin="0,15,0,0">
            <Canvas Width="410" Margin="15,0,0,0" Background="Gainsboro">
                <Label Content="Fahrzeuginformationen" Height="72" Width="410" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="DarkGray"/>
                <Label Content="Rundumleuchte:" Canvas.Top="80" Height="35" Width="205" VerticalContentAlignment="Center" FontSize="18"/>
                <Label Content="Ø Geschwindigkeit:" Canvas.Top="115" Height="35" Width="205" VerticalContentAlignment="Center" FontSize="18" Background="#FFCFCFCF"/>
                <Label Content="Kraftstoffverbrauch:" Canvas.Top="150" Height="35" Width="205" VerticalContentAlignment="Center" FontSize="18"/>
                <ProgressBar x:Name="progressBar_fuel" Height="35" Foreground="LimeGreen" Value="0" Background="White" Width="400" Canvas.Top="190" Padding="0" Margin="5,0,0,0"/>
                <Label x:Name="label_progressBar_fuelText" Content="0 l  /  0 l  (0 km)" Width="400" Height="35" Padding="5, 0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Canvas.Left="5" Canvas.Top="190"/>
                <Label x:Name="label_beaconState" Content="ausgeschaltet" Canvas.Left="205" Canvas.Top="80" Height="35" Width="205" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="18"/>
                <Label x:Name="label_averageSpeed" Content="0,00 km/h" Canvas.Left="205" Canvas.Top="115" Height="35" Width="205" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="18" Background="#FFCFCFCF"/>
                <Label x:Name="label_averageFuelConsumption" Content="0,00 l/100km" Canvas.Left="205" Canvas.Top="150" Height="35" Width="205" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="18"/>
                <Border Height="235" Width="410" BorderThickness="2" BorderBrush="Black" />
            </Canvas>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,0" Height="492">
            <Grid Height="65" Width="410" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,0" Background="Gainsboro">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1.3*"/>
                </Grid.RowDefinitions>
                <Label x:Name="label_currentArrivalText" Content="Ankunft ca.:" Margin="0" VerticalContentAlignment="Center" Background="Brown" Padding="5,0" FontWeight="Bold" FontSize="16" />
                <Label Content="Beste Ankunft:" Grid.Row="1" VerticalContentAlignment="Center" Padding="5,0" FontSize="16" />
                <Label Content="Beste Fahrzeit:" Grid.Row="2" Margin="0" VerticalContentAlignment="Center" FontSize="10" Background="DarkGray" Padding="5,0"/>
                <Label x:Name="label_dt_currentArrival" Content="00:00 Uhr" VerticalContentAlignment="Center" Grid.ColumnSpan="1" Grid.Column="1" HorizontalContentAlignment="Center" Background="Brown" Padding="0" FontWeight="Bold" FontSize="16"/>
                <Label x:Name="label_dt_currentBestArrival" Content="00:00 Uhr" Grid.ColumnSpan="1" Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="16" />
                <Label x:Name="label_dt_bestArrival" Content="00:00 - 00:00 Uhr" Grid.Row="2" Margin="0" VerticalContentAlignment="Center" Grid.Column="1" HorizontalContentAlignment="Center" FontSize="10" Background="DarkGray" Padding="0"/>
                <Label x:Name="label_ts_currentArrival" Content="(0 Min.)" VerticalContentAlignment="Center" Grid.ColumnSpan="1" Grid.Column="2" HorizontalContentAlignment="Right" Background="Brown" Padding="5,0" FontWeight="Bold" FontSize="16"/>
                <Label x:Name="label_ts_currentBestArrival" Content="(0 Min.)" VerticalContentAlignment="Center" Grid.ColumnSpan="1" Grid.Column="2" Grid.Row="1" HorizontalContentAlignment="Right" Padding="5,0" FontSize="16"/>
                <Label x:Name="label_ts_bestArrival" Content="(0 Min.)" Grid.Row="2" VerticalContentAlignment="Center" Grid.Column="2" HorizontalContentAlignment="Right" FontSize="10" Background="DarkGray" Padding="5,0"/>
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" BorderThickness="2" Grid.ColumnSpan="3" Grid.RowSpan="3" />
            </Grid>
            <Canvas HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,15,0,0" Width="410" Height="268" Background="Gainsboro">
                <Label Content="Auftragsinformationen" Height="72" Width="410" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="DarkGray"/>
                <Canvas Canvas.Top="152" Height="116" Width="410" VerticalAlignment="Bottom" Background="DarkGray">
                    <Label x:Name="label_jobInfoFreight" Content="Leerfahrt" Height="25" Width="410" Padding="5,0,5,0.2" VerticalContentAlignment="Center"/>
                    <Label x:Name="label_jobInfoMass" Content="0 t" Height="25" Width="410" Padding="5,0,5,0.2" VerticalContentAlignment="Center" Canvas.Top="25"/>
                    <Label x:Name="label_jobInfoIncome" Content="0 € (0 €/km)" Height="25" Width="410" Padding="5,0,5,0.2" VerticalContentAlignment="Center" Canvas.Top="50"/>
                    <ProgressBar x:Name="progressBar_damage" Height="25" Foreground="Brown" Value="0" Background="White" Width="400" Canvas.Top="81" Canvas.Left="5"/>
                    <Label x:Name="label_progressBar_damageText" Content="0 %" Height="25" Width="400" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="5, 0" Canvas.Left="5" Canvas.Top="81"/>
                </Canvas>
                <Label x:Name="label_nextRestStop" Content="Pause in: 0 Min." Canvas.Top="72" Height="40" VerticalContentAlignment="Center" Foreground="Brown" Width="410"/>
                <Label x:Name="label_remainingDeliveryTime" Content="Restzeit: 0 Min." Canvas.Top="112" Height="40" Width="410" VerticalContentAlignment="Center" Foreground="Brown" />
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" BorderThickness="2" Height="268" Width="410" />
            </Canvas>
            <Grid Height="116" Margin="15,15,15,8">
                <Grid Height="55" VerticalAlignment="Stretch" Margin="0,0,0,61">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="" Padding="5,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"/>
                    <Label Content="" Margin="0" Grid.Row="1" Padding="5,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"/>
                    <Label Content="" Grid.Column="1" HorizontalContentAlignment="Right" Padding="5,0" VerticalContentAlignment="Center"/>
                    <Label Content="" Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Right" Padding="5,0" VerticalContentAlignment="Center"/>
                </Grid>
                <ProgressBar x:Name="progressBar_distance" Height="25" Foreground="LimeGreen" Value="0" Background="White" Canvas.Top="-14" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,55,0,36"/>
                <Label x:Name="label_progressBar_distanceText" Content="0 km / 0 km" Margin="0,55,0,38" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="5,0"/>
                <Grid Height="25" Margin="0,83,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="830*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="135"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="label_drivenDistanceProgress" Content="0,00 %" Padding="5,0" Background="White" VerticalContentAlignment="Center"/>
                    <Label x:Name="label_timebuffer" Content="Zeitpuffer: 0 Min." Grid.Column="2" Margin="0"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="Brown" Padding="5,0"/>
                    <Label x:Name="label_remainingDistance" Content="Noch 0 km" Grid.Column="5" Margin="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Background="White" Padding="5,0"/>
                </Grid>
            </Grid>
        </StackPanel>
        <StackPanel Margin="0,0,0,0"/>
    </DockPanel>
</Window>
