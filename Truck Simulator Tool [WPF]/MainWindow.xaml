                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="" Padding="5,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"/>
                    <Label Content="" Margin="0" Grid.Row="1" Padding="5,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"/>
                    <Label Content="" Grid.Column="1" HorizontalContentAlignment="Right" Padding="5,0" VerticalContentAlignment="Center"/>
                    <Label Content="" Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Right" Padding="5,0" VerticalContentAlignment="Center"/>
                </Grid>
                <ProgressBar Height="25" Foreground="Brown" Value="0" Background="White" Canvas.Top="-14" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,3,0,0"/>
                <Grid Height="25" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="830*"/>
                        <ColumnDefinition Width="3*"/>
